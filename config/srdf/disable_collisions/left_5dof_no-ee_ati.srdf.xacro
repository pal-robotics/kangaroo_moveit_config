<?xml version="1.0" ?>
<robot name="kangaroo" xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:include filename="$(find kangaroo_moveit_config)/config/srdf/disable_collisions/left_5dof_no-ee.srdf.xacro" />
    <disable_collisions link1="wrist_left_ft_sensor_base_link" link2="wrist_left_ft_sensor_link" reason="Adjacent"/>
    <disable_collisions link1="wrist_left_ft_sensor_base_link" link2="wrist_left_ft_tool_link" reason="Adjacent"/>
    <disable_collisions link1="wrist_left_ft_sensor_link" link2="wrist_left_ft_tool_link" reason="Never"/>
</robot>
