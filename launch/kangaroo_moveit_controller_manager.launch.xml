<launch>
  <!-- loads moveit_controller_manager on the parameter server which is taken as argument 
    if no argument is passed, moveit_simple_controller_manager will be set -->
  <arg name="moveit_controller_manager" default="moveit_simple_controller_manager/MoveItSimpleControllerManager" />
  <param name="moveit_controller_manager" value="$(arg moveit_controller_manager)"/>
  <arg name="controller_manager_name" default="controller_manager" />
  <param name="controller_manager_name" value="$(arg controller_manager_name)" />
  <arg name="use_controller_manager" default="true" />
  <arg name="robot_type" default="" />
  
  <param name="use_controller_manager" value="$(arg use_controller_manager)" />

  <group if="$(eval str(robot_type) in ['full', 'pelvis_no_arms'])">
    <rosparam file="$(find kangaroo_moveit_config)/config/controllers_pelvis.yaml"/>
  </group>

  <group if="$(eval str(robot_type) in ['full', 'arms_no_pelvis'])">
    <rosparam file="$(find kangaroo_moveit_config)/config/controllers_arms.yaml"/>
  </group>
  
  <rosparam file="$(find kangaroo_moveit_config)/config/controllers_legs.yaml"/>

</launch>
